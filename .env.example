# Copy this file to .env.local and fill in your actual values.
#
# Database: this repo ships consolidated SQL in supabase/migrations/.
# Local: run `supabase db reset` after linking the project to apply schema + seed.
# Remote: run the two migration files in order in the Supabase SQL Editor (or use the CLI).
# Server-only — same screen, “service_role” secret. Strongly recommended for admin API (bypasses RLS).
# Also accepted: SUPABASE_SERVICE_KEY (non-standard alias).
# Without this, admin writes use your login session and must pass RLS on `games` and `featured_games`.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpnY3ZnZmp5ZmJ2dXJ6eWdwZHV5Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3OTEyODM0OSwiZXhwIjoyMDk0NzA0MzQ5fQ.r3pjfbQTIOfMWHQHjbH_Jn7VPudNESsmd3tUyrpjceA

